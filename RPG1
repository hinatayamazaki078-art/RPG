function initBattle() {
    if (stage > currentEndStage) { 
        addLog(`★第 ${currentEndStage} 層 領域制覇！★`); if (stage - 1 > maxClearedStage) maxClearedStage = stage - 1; saveData(); 
        if (maxClearedStage >= 300) addLog("★完全踏破！★"); setTimeout(() => location.reload(), 2500); return; 
    }
    document.getElementById('header-stage-label').innerText = `第 ${stage} 層`;
    let enemyNames = stageBaseData[(stage-1) % stageBaseData.length];
    enemies = enemyNames.map((n, i) => {
        let base = charData.find(c => c.name === n) || charData[0]; let buff = Math.floor(stage / 4);
        return {...base, id: 900+i, curH: base.h+buff*5, maxH: base.h+buff*5, p: base.p+buff, baseP: base.p+buff, baseS: base.s, curM: base.m, maxM: base.m, isP: false, poison: false, guard: false, charm: 0, lastDmg: 0, aura: null, usedPhoenix: false, blind: false, paralyze: false, atkBuff: 0, invincible: 0, deathTrap: false};
    });
    document.getElementById('log').innerText = ""; addLog(`--- 第 ${stage} 層 ---`); cycle();
}

function checkAndRevivePhoenix(u) {
    if (u.curH <= 0 && (u.name === '不死鳥' || u.skill === '不死の再生') && !u.usedPhoenix) {
        u.curH = u.maxH; u.curM = u.maxM; u.usedPhoenix = true; addLog(`✨【不死の再生】${u.name}は炎を纏い完全復活した！`); return true;
    } return false;
}

function cycle() {
    const all = [...party, ...enemies];
    all.forEach(u => {
        if (u.name === '蛆' && u.curH <= 0 && all.some(p => p.name === '蝿' && p.curH > 0 && p.isP === u.isP)) { u.curH = 1; addLog(`${u.name}が再生した！`); }
        if (u.name === '狼' && u.curH > 0) { const count = all.filter(o => o.name === '狼' && o.curH > 0 && o.isP === u.isP && o.id !== u.id).length; u.p = u.baseP + count; u.s = u.baseS + count; }
        u.guard = false;
    });
    queue = all.filter(u => u.curH > 0).sort((a,b)=>b.s - a.s); qIdx = 0; if (queue.length === 0) return next();
    document.getElementById('turn-order').innerText = queue.map(u => u.name).join(" > ");
    queue.forEach(u => {
        if (u.aura && u.aura.type === '回復') {
            const healVal = Math.floor(u.maxH * (u.aura.value / 100));
            if (healVal > 0) { u.curH = Math.min(u.maxH, u.curH + healVal); addLog("🌿【回復】" + u.name + " +" + healVal); }
        }
    });
    updateUI(); remainingActions = 0; turn();
}

async function turn() {
    isSelecting = false; currentAction = null; updateUI(); const u = queue[qIdx]; if (!u || u.curH <= 0) return next();
    if (u.paralyze) { u.paralyze = false; addLog(`⚡ ${u.name}は麻痺で動けない！`); return next(); }
    if (u.deathTrap && Math.random() < 0.1) { u.curH = Math.max(0, u.curH - 20); addLog(`⚠️ 罠発動！ ${u.name} に 20 ダメージ！`); checkAndRevivePhoenix(u); if(u.curH <= 0) return next(); }
    
    if (darumaTrigger !== null && darumaTrigger !== u.isP) {
        darumaTrigger = null; u.curH = Math.max(0, u.curH - 20); addLog(`🚨 動いたな！「達磨さんが転んだ」の呪いが発動！ ${u.name} に 20 ダメージ！`); checkAndRevivePhoenix(u); if (u.curH <= 0) return next();
    }
    if (remainingActions <= 0) {
        remainingActions = 1;
        if (u.aura && u.aura.type === '行動力') {
            let bonus = u.aura.value; if (u.aura.r === 2) bonus = Math.random() < 0.5 ? 1 : 2; if (u.aura.r === 4) bonus = Math.random() < 0.5 ? 2 : 3;
            remainingActions = bonus; if (remainingActions > 1) addLog("⚡【行動力】" + u.name + "は研ぎ澄まされている！（残り行動: " + remainingActions + "回）");
        }
    }
    if (u.poison) { u.curH = Math.max(0, u.curH - 1); addLog(u.name + "：毒1ダメ"); checkAndRevivePhoenix(u); if(u.curH <= 0) return next(); }
    if (u.charm > 0) {
        u.charm--; addLog(u.name + "は魅了中！"); await new Promise(r => setTimeout(r, 600));
        const allies = (u.isP ? party : enemies).filter(a => a.curH > 0 && a.id !== u.id);
        if (allies.length > 0) executeAction(u, allies[Math.floor(Math.random()*allies.length)], 'attack'); else next(); return;
    }
    if (u.isP) { 
        document.getElementById('btn-atk').disabled = false; document.getElementById('btn-skl').disabled = !u.skill || u.skill === '再生' || u.skill === '不死の再生'; 
    } else {
        document.getElementById('btn-atk').disabled = true; document.getElementById('btn-skl').disabled = true; await new Promise(r => setTimeout(r, 600));
        const t_list = party.filter(p => p.curH > 0);
        if (t_list.length > 0) {
            const isAuto = ['感電', '咆哮', '鱗粉', '御廚子', '巨大触手', '炎のブレス', '伏魔御廚子', '達磨さんが転んだ', 'ムチ', '攻撃増幅薬', 'ブリザード', '支配', '妖精の粉', 'デストラップ', '蘇りの歌', '強固な甲羅', '天変地異', 'デスペラードヒューリー'].includes(u.skill);
            const isTarget = ['毒牙', '丸呑み', '連撃', 'イーター', '猛毒', '神の審判', 'マジ殴り', '斬撃', '閃光', '麻痺', '捨て身', 'メテオ'].includes(u.skill);
            let costNum = u.skill==='捨て身'?5:u.cost; let canUseSkill = (u.skill==='捨て身'?u.curH>costNum:u.curM>=costNum);
            
            if ((isAuto || isTarget) && canUseSkill) executeAction(u, t_list[Math.floor(Math.random()*t_list.length)], 'skill'); else executeAction(u, t_list[Math.floor(Math.random()*t_list.length)], 'attack');
        } else next();
    }
}

function startTargetSelection(type) {
    const u = queue[qIdx];
    if (type === 'skill') {
        let isHpSkill = (u.skill === '捨て身' || u.skill === '精霊の歌'); let costNum = u.cost;
        if (u.skill === '精霊の歌') costNum = Math.floor(u.curH / 2); else if (u.skill === '捨て身') costNum = 5;
        if (isHpSkill && u.curH <= costNum) return addLog("HP不足！");
        if (!isHpSkill && u.curM < u.cost) return addLog("MP不足！");

        const s = u.skill;
        const isEnemySingle = ['斬撃', '閃光', '麻痺', '捨て身', 'メテオ', '毒牙', '吸血', '血欲', '物真似', '丸呑み', '猛毒', '連撃', 'イーター', '魅了', '神の審判', 'マジ殴り'].includes(s);
        const isAllySingle = ['回復', '大回復', '応援', '賢者の知恵', '身代わり', '甘い蜜'].includes(s);
        const isDeadSingle = ['フェニックス', '精霊の歌'].includes(s);
        const isAuto = ['ムチ', '攻撃増幅薬', 'ブリザード', '支配', '妖精の粉', 'デストラップ', '蘇りの歌', '強固な甲羅', '天変地異', 'デスペラードヒューリー', '感電', '咆哮', '鱗粉', '御廚子', '巨大触手', '炎のブレス', '伏魔御廚子', '達磨さんが転んだ', '不死の再生', '再生', '転生'].includes(s);

        if (isAuto) return executeAction(u, null, 'skill');
        else if (isEnemySingle) { currentAction = 'skill_enemy'; addLog("標的(敵)を選択"); }
        else if (isAllySingle) { currentAction = 'skill_ally'; addLog("味方を選択"); }
        else if (isDeadSingle) { currentAction = 'skill_dead'; addLog("復活させる味方を選択"); }
        else { currentAction = 'skill_enemy'; addLog("標的を選択"); }
    } else { currentAction = 'attack'; addLog("標的を選択"); }
    isSelecting = true; updateUI();
}

function onUnitClick(targetId) {
    if (!isSelecting) return;
    const target = [...party, ...enemies].find(char => char.id === targetId); if (!target) return;
    const u = queue[qIdx];
    if (currentAction === 'attack' || currentAction === 'skill_enemy') { if (target.isP === u.isP || target.curH <= 0) return; }
    else if (currentAction === 'skill_ally') { if (target.isP !== u.isP || target.curH <= 0) return; }
    else if (currentAction === 'skill_dead') { if (target.isP !== u.isP || target.curH > 0) return; }
    executeAction(u, target, currentAction); isSelecting = false; currentAction = null;
}

function executeAction(u, t, type) {
    if (type.startsWith('skill')) {
        if (u.skill === '捨て身') u.curH -= 5;
        else if (u.skill === '精霊の歌') u.curH -= Math.floor(u.curH / 2);
        else u.curM -= u.cost;
        addLog(u.name + "：【" + u.skill + "】");
    }

    if (type === 'attack') {
        if (u.blind && Math.random() < 0.3) { addLog("👁️ 閃光の影響で攻撃を外した！"); return next(); }
        if (t.aura && t.aura.type === '回避' && Math.random() * 100 < t.aura.value) { addLog("💨【回避】" + t.name + "は攻撃を完全に避けた！"); return next(); }
        let dmg = u.p; if (u.atkBuff > 0) dmg *= 2; if (isDominating) dmg = Math.floor(dmg / 2);
        let isCrit = false; if (u.aura && u.aura.type === '会心' && Math.random() * 100 < u.aura.value) { dmg *= 2; isCrit = true; }
        if (t.guard) dmg = 1;
        if (t.invincible > 0) dmg = 0;
        
        dmg = Math.max(0, dmg); t.curH = Math.max(0, t.curH - dmg); u.lastDmg = dmg;
        if (t.invincible > 0) addLog("🛡️ 強固な甲羅により無傷！");
        else if (isCrit) addLog("💥【会心】" + u.name + "の一撃：" + dmg + "ダメ");
        else addLog(u.name + "の攻撃：" + dmg + "ダメ");
        checkAndRevivePhoenix(t);
    } else {
        const targets = u.isP ? enemies : party; const allies = u.isP ? party : enemies;
        const dealDmg = (tgt, val) => { if(tgt.invincible>0) return 0; let d = val; if(isDominating) d=Math.floor(d/2); tgt.curH = Math.max(0, tgt.curH - d); checkAndRevivePhoenix(tgt); return d; };
        
        // 新スキル
        if (u.skill === '回復') { t.curH = Math.min(t.maxH, t.curH + Math.floor(t.maxH*0.3)); addLog(t.name + "のHPが30%回復！"); }
        else if (u.skill === '大回復') { t.curH = Math.min(t.maxH, t.curH + Math.floor(t.maxH*0.6)); addLog(t.name + "のHPが60%回復！"); }
        else if (u.skill === '妖精の粉') { allies.forEach(a=>{if(a.curH>0)a.curH = Math.min(a.maxH, a.curH + Math.floor(a.maxH*0.8));}); addLog("味方全体のHPが80%回復！"); }
        else if (u.skill === '閃光') { t.blind = true; addLog(t.name + "の目が眩んだ！"); }
        else if (u.skill === '麻痺') { if(Math.random()<0.3){ t.paralyze = true; addLog(t.name + "を麻痺させた！"); }else addLog("効かなかった..."); }
        else if (u.skill === '斬撃') { dealDmg(t, 5); addLog(t.name + "に5ダメージ！"); }
        else if (u.skill === '捨て身') { dealDmg(t, 10); addLog("捨て身の一撃！ " + t.name + "に10ダメージ！"); }
        else if (u.skill === 'メテオ') { dealDmg(t, 35); addLog("隕石が直撃！ " + t.name + "に35ダメージ！"); }
        else if (u.skill === 'ムチ') { targets.forEach(e => { if(e.curH>0) dealDmg(e, 2); }); addLog("全体に2ダメージ！"); }
        else if (u.skill === 'ブリザード') { targets.forEach(e => { if(e.curH>0){ dealDmg(e, 10); e.s -= 2; } }); addLog("全体に10ダメージ＆速さ低下！"); }
        else if (u.skill === '天変地異') { targets.forEach(e => { if(e.curH>0) dealDmg(e, 150); }); addLog("世界が揺れる！ 全体に150ダメージ！"); }
        else if (u.skill === '応援') { t.atkBuff = 2; addLog(t.name + "の攻撃力が一時的に倍になった！"); }
        else if (u.skill === '攻撃増幅薬') { allies.forEach(a=>{if(a.curH>0)a.atkBuff = 2;}); addLog("味方全員の攻撃力が一時的に倍になった！"); }
        else if (u.skill === '支配') { isDominating = true; addLog("支配空間発動！ 試合中全員の攻撃力が半減する！"); }
        else if (u.skill === 'デストラップ') { targets.forEach(e => { e.deathTrap = true; }); addLog("敵陣にデストラップを仕掛けた！"); }
        else if (u.skill === 'フェニックス') { t.curH = t.maxH; addLog(t.name + "が完全復活した！"); }
        else if (u.skill === '蘇りの歌') { allies.forEach(a => { if(a.curH<=0) addLog(a.name+"が復活！"); a.curH = a.maxH; a.usedPhoenix = false; }); addLog("蘇りの歌で味方全員が全回復！"); }
        else if (u.skill === '強固な甲羅') { allies.forEach(a=>{if(a.curH>0)a.invincible = 2;}); addLog("味方全員が1ターンの間無敵になった！"); }
        else if (u.skill === 'デスペラードヒューリー') { 
            addLog("狂気の乱舞！"); 
            for(let i=0; i<5; i++){
                let aliveTgts = targets.filter(e=>e.curH>0); if(aliveTgts.length===0) break;
                let rndTgt = aliveTgts[Math.floor(Math.random()*aliveTgts.length)]; dealDmg(rndTgt, 50);
            }
        }
        else if (u.skill === '精霊の歌') { t.curH = Math.floor(t.maxH/2); addLog(`自らの命を削り、${t.name}を復活させた！`); }
        
        // 既存スキル
        else if (u.skill === '感電') { targets.forEach(e => { if(e.curH>0) dealDmg(e, 3); }); }
        else if (u.skill === '御廚子' || u.skill === '伏魔御廚子') { targets.forEach(e => { if(e.curH>0) dealDmg(e, 30); }); addLog("領域展開。全体に30のダメージ！"); }
        else if (u.skill === '巨大触手') { targets.forEach(e => { if(e.curH>0) dealDmg(e, 10); }); addLog("巨大な触手が敵全体を薙ぎ払う！"); }
        else if (u.skill === '炎のブレス') { targets.forEach(e => { if(e.curH>0) dealDmg(e, 20); }); addLog("灼熱の烈火が敵全体を包み込む！"); }
        else if (u.skill === '達磨さんが転んだ') { darumaTrigger = u.isP; addLog("達磨がこちらを凝視している...（次に動いた敵へ罠発動）"); }
        else if (u.skill === '神の審判') { let judgeDmg = Math.random() < 0.5 ? 10 : 60; dealDmg(t, judgeDmg); addLog(`天からの光！ ${t.name}に ${judgeDmg} の審判ダメージ！`); }
        else if (u.skill === '連撃') { let d1=u.p, d2=u.p; if(u.atkBuff>0){d1*=2;d2*=2;} if(isDominating){d1=Math.floor(d1/2);d2=Math.floor(d2/2);} dealDmg(t, d1); dealDmg(t, d2); u.lastDmg = d1 + d2; addLog(`連続の斬撃！ ${t.name}に ${d1}、${d2} の連続ダメージ！`); }
        else if (u.skill === 'マジ殴り') { dealDmg(t, 200); addLog(`必殺のマジ殴り！ ${t.name}に致命的なダメージ！`); }
        else if (u.skill === 'イーター') { dealDmg(t, 30); u.curH = Math.min(u.maxH, u.curH + 30); addLog(`${t.name}から魂を喰らう！`); }
        else if (u.skill === '魅了') { t.charm = 2; addLog(t.name + "を魅了！"); }
        else if (u.skill === '吸血') { u.curH = Math.min(u.maxH, u.curH + 3); }
        else if (u.skill === '血欲') { dealDmg(t, 2); u.curH = Math.min(u.maxH, u.curH + 2); }
        else if (u.skill === '物真似') { dealDmg(t, u.lastDmg); }
        else if (u.skill === '賢者の知恵') { t.curH = Math.min(t.maxH, t.curH + 5); }
        else if (u.skill === '鱗粉') targets.forEach(e => { if(e.curH>0) e.poison = true; });
        else if (u.skill === '咆哮') targets.forEach(e => { if(e.curH>0) dealDmg(e, 8); });
        else if (u.skill === '身代わり') { u.guard = true; }
        else if (u.skill === '転生') { t.curH = t.maxH; }
        else if (u.skill === '毒牙' || u.skill === '猛毒') { t.poison = true; addLog(t.name + "を致命的な毒にした！"); }
        else if (u.skill === '甘い蜜') { t.curH = Math.min(t.maxH, t.curH + 3); addLog(t.name + "のHPが3回復！"); }
        else if (u.skill === '丸呑み') { dealDmg(t, 15); addLog(t.name + "に15の固定ダメージ！"); }
    }
    
    if (u.atkBuff > 0) u.atkBuff--; if (u.invincible > 0) u.invincible--;
    next();
}

function next() {
    updateUI();
    if (enemies.every(e => e.curH <= 0)) { 
        party.forEach(p => { p.curH = p.maxH; p.curM = p.m; p.poison = false; p.charm = 0; p.guard = false; p.usedPhoenix = false; p.blind=false; p.paralyze=false; p.atkBuff=0; p.invincible=0; p.deathTrap=false; });
        addLog("勝利！全員全回復した");
        if (isBossMode) {
            addLog("強者を退けた！"); if (Math.random() < 0.05) { const base = charData.find(c => c.name === currentBossName); box.push({...base, id: Math.random(), auraId: null, weaponId: null}); addLog("★" + currentBossName + "が仲間に加わった！"); }
            saveData(); setTimeout(()=>location.reload(), 1500);
        } else if (isDigMode) {
            const d = digDataList[currentDigTier]; weapons.push({ id: Math.random(), name: d.wp }); addLog(`秘宝発掘成功！⚔️装具【${d.wp}】を獲得！`);
            if (Math.random() < d.stoneChance) { stones += d.stoneCount; addLog(`💎さらに【強化石】を${d.stoneCount}個手に入れた！`); }
            saveData(); setTimeout(() => location.reload(), 3000);
        } else {
            let reward = stage >= 201 ? 12 : stage >= 101 ? 8 : stage >= 51 ? 5 : stage >= 31 ? 4 : stage >= 21 ? 3 : stage >= 11 ? 2 : 1;
            coins += reward; document.getElementById('global-coin-count').innerText = coins; addLog(`勝利報酬: コイン ${reward} 枚獲得！`);
            if (stage > maxClearedStage) maxClearedStage = stage; saveData(); stage++; setTimeout(initBattle, 800);
        } return; 
    }
    if (party.every(p => p.curH <= 0)) { addLog("全滅..."); setTimeout(()=>location.reload(), 2000); return; }

    remainingActions--; if (remainingActions > 0 && queue[qIdx] && queue[qIdx].curH > 0) { addLog("⚡ 連撃発動！（残り行動: " + remainingActions + "回）"); turn(); } 
    else { remainingActions = 0; qIdx++; if (qIdx >= queue.length) cycle(); else turn(); }
}

function updateUI() {
    const activeUnit = queue[qIdx];
    const draw = (u) => {
        let classes = `char-box ${u.curH<=0?'dead':''} ${activeUnit && u.id===activeUnit.id?'active-unit':''}`;
        
        let isSelectableTarget = false;
        if (isSelecting) {
            if (currentAction === 'skill_dead') { if (u.curH <= 0 && u.isP) isSelectableTarget = true; }
            else if (currentAction === 'skill_ally') { if (u.curH > 0 && u.isP) isSelectableTarget = true; }
            else if (currentAction === 'attack' || currentAction === 'skill_enemy') { if (u.curH > 0 && !u.isP) isSelectableTarget = true; }
        }
        if (isSelectableTarget) classes += ' selectable';

        let auraClass = ""; if (u.curH > 0 && u.aura && u.aura.type) auraClass = `glow-${u.aura.type}`;
        let overrideColor = "";
        if (u.charm > 0) overrideColor = "color:#f0f;"; else if (u.poison) overrideColor = "color:#0f0;"; else if (u.guard || u.invincible > 0) overrideColor = "color:#0aa;"; else if (u.atkBuff > 0) overrideColor = "color:#ff5;";
        
        return `<div class="${classes}" onclick="onUnitClick(${u.id})">
            <span class="kanji ${auraClass}" style="${overrideColor}; font-size:${u.name.length >= 4 ? '15px' : '38px'}; white-space:nowrap;">${u.name}</span>
            <div class="hp-bar-bg"><div class="hp-bar-fill" style="width:${(u.curH/u.maxH)*100}%\"></div></div>
            <div class="stats-text">H:${u.curH} P:${u.p}</div>
        </div>`;
    };
    document.getElementById('player-area').innerHTML = party.map(draw).join(''); document.getElementById('enemy-area').innerHTML = enemies.map(draw).join('');
}
function addLog(m) { const l = document.getElementById('log'); l.innerText += m + "\n"; l.scrollTop = l.scrollHeight; }

if (!loadData()) { ['蟻','蝿','蛆'].forEach(n => { const b = charData.find(c => c.name === n); if(b) box.push({...b, id: Math.random(), auraId: null, weaponId: null}); }); maxClearedStage = 0; saveData(); }
updateHomeUI();
</script>
</body>
</html>
