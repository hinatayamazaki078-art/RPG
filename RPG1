function playGacha(times) {
    const cost = times === 10 ? 100 : 10; if (coins < cost) return alert(`コインが不足しています！`);
    coins -= cost; document.getElementById('global-coin-count').innerText = coins;
    showGachaOverlay("");
    let currentPull = 0;
    const pullNext = () => {
        if (currentPull >= times) {
            document.getElementById('gacha-kanji-display').style.display = 'none';
            document.getElementById('gacha-result-name').innerText = "── 召喚結果 ──";
            document.getElementById('gacha-close-btn').style.display = 'block'; saveData(); return;
        }
        let count = 0; document.getElementById('gacha-result-name').innerText = `${currentPull + 1} 体目を召喚中...`;
        const interval = setInterval(() => {
            const randDisp = charData[Math.floor(Math.random() * charData.length)];
            document.getElementById('gacha-kanji-display').innerHTML = `<span style="font-size:${randDisp.name.length >= 4 ? '40px' : '120px'};">${randDisp.name}</span>`;
            count++;
            if (count > 12) {
                clearInterval(interval); let sr = 1; const roll = Math.random() * 100;
                if (times === 10 && currentPull === 9) {
                    const fw = Math.random() * 15; if(fw<8) sr=3; else if(fw<13) sr=4; else if(fw<14.5) sr=5; else sr=6;
                } else {
                    if (roll < 70) sr = 1; else if (roll < 85) sr = 2; else if (roll < 93) sr = 3; else if (roll < 98) sr = 4; else if (roll < 99.5) sr = 5; else sr = 6;
                }
                const pool = charData.filter(c => c.r === sr); const base = pool[Math.floor(Math.random() * pool.length)];
                const newUnit = {...base, id: Math.random(), auraId: null, weaponId: null}; box.push(newUnit);
                
                const disp = document.getElementById('gacha-kanji-display'); disp.className = ""; disp.innerHTML = `<span style="font-size:${base.name.length >= 4 ? '50px' : '120px'};">${base.name}</span>`;
                if(base.r>=7) disp.classList.add('rarity-god7'); else if(base.r===6) disp.classList.add('rarity-god'); else if(base.r>=4) disp.classList.add('rarity-high');
                
                let bCol = base.r>=7?'#f00':base.r===6?'#f0f':base.r>=4?'#ff0':'#444';
                let tCol = base.r>=7?'#faa':base.r===6?'#f0f':base.r>=4?'#ff0':'#fff';
                document.getElementById('gacha-result-list').innerHTML += `<div class="gacha-res-item" style="color:${tCol}; border-color:${bCol}"><span class="rarity">${'★'.repeat(base.r)}</span><span>${base.name}</span></div>`;
                currentPull++; setTimeout(pullNext, 200);
            }
        }, 30);
    }; pullNext();
}

