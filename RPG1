function attachSeedFromHome(seedIndex) {
    if (selectedIds.length === 0) return alert("種を付ける漢字を上のリストから選択してください。");
    const char = box.find(b => b.id === selectedIds[selectedIds.length - 1]);
    if (char) {
        const seed = seeds[seedIndex];
        if (char.skill && !confirm(`既にスキル【${char.skill}】を持っています。上書きして【${seed.name}】を習得させますか？`)) return;
        char.skill = seed.name; char.cost = seed.cost || 1; seeds.splice(seedIndex, 1);
        alert(`${char.name} に 【${seed.name}】 のスキルを付与しました！`); saveData(); updateHomeUI();
    }
}

function equipWeaponFromHome(weaponIndex) {
    if (selectedIds.length === 0) return alert("武器を装備させる漢字を選択してください。");
    const char = box.find(b => b.id === selectedIds[selectedIds.length - 1]), weapon = weapons[weaponIndex];
    if (!char || !weapon) return;
    const currentOwner = box.find(b => b.weaponId === weapon.id); if (currentOwner) currentOwner.weaponId = null;
    if (char.weaponId === weapon.id) { char.weaponId = null; alert(`${char.name} の装具を外しました。`); } 
    else { char.weaponId = weapon.id; alert(`${char.name} に 【${weapon.name}】 を装備しました！`); }
    saveData(); updateHomeUI();
}

